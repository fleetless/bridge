<?xml version="1.0" encoding="UTF-8" ?>
<!-- Opt in per ROS process. Do not set this profile for the robot's whole domain. -->
<profiles xmlns="http://www.eprosima.com/XMLSchemas/fastRTPS_Profiles">
  <participant profile_name="fleetless_action_server_liveness" is_default_profile="true">
    <rtps>
      <builtin>
        <discovery_config>
          <leaseDuration><sec>1</sec></leaseDuration>
          <leaseAnnouncement><nanosec>250000000</nanosec></leaseAnnouncement>
        </discovery_config>
      </builtin>
    </rtps>
  </participant>
</profiles>
