{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "type": {
      "type": "string",
      "const": "config_applied"
    },
    "version": {
      "type": "integer",
      "minimum": 0,
      "maximum": 9007199254740991
    },
    "ok": {
      "type": "boolean"
    },
    "errors": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "slug": {
            "type": "string"
          },
          "kind": {
            "type": "string",
            "enum": [
              "datapoint",
              "action",
              "service",
              "publisher",
              "camera",
              "low_bandwidth"
            ]
          },
          "code": {
            "type": "string",
            "minLength": 1,
            "maxLength": 40
          },
          "message": {
            "type": "string",
            "minLength": 1
          },
          "details": {
            "type": "object",
            "propertyNames": {
              "type": "string"
            },
            "additionalProperties": {}
          }
        },
        "required": [
          "slug",
          "kind",
          "code",
          "message"
        ]
      }
    }
  },
  "required": [
    "type",
    "version",
    "ok",
    "errors"
  ]
}
