{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "type": {
      "type": "string",
      "const": "introspect"
    },
    "request_id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 64
    },
    "graph": {
      "type": "object",
      "properties": {
        "topics": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "name": {
                "type": "string",
                "maxLength": 255,
                "pattern": "^\\/[A-Za-z_][A-Za-z0-9_]*(?:\\/[A-Za-z_][A-Za-z0-9_]*)*$"
              },
              "types": {
                "minItems": 1,
                "type": "array",
                "items": {
                  "type": "string",
                  "maxLength": 255,
                  "pattern": "^[a-z][a-z0-9_]*\\/(?:msg|srv|action)\\/[A-Za-z][A-Za-z0-9]*$"
                }
              }
            },
            "required": [
              "name",
              "types"
            ],
            "additionalProperties": false
          }
        },
        "services": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "name": {
                "type": "string",
                "maxLength": 255,
                "pattern": "^\\/[A-Za-z_][A-Za-z0-9_]*(?:\\/[A-Za-z_][A-Za-z0-9_]*)*$"
              },
              "types": {
                "minItems": 1,
                "type": "array",
                "items": {
                  "type": "string",
                  "maxLength": 255,
                  "pattern": "^[a-z][a-z0-9_]*\\/(?:msg|srv|action)\\/[A-Za-z][A-Za-z0-9]*$"
                }
              }
            },
            "required": [
              "name",
              "types"
            ],
            "additionalProperties": false
          }
        },
        "actions": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "name": {
                "type": "string",
                "maxLength": 255,
                "pattern": "^\\/[A-Za-z_][A-Za-z0-9_]*(?:\\/[A-Za-z_][A-Za-z0-9_]*)*$"
              },
              "types": {
                "minItems": 1,
                "type": "array",
                "items": {
                  "type": "string",
                  "maxLength": 255,
                  "pattern": "^[a-z][a-z0-9_]*\\/(?:msg|srv|action)\\/[A-Za-z][A-Za-z0-9]*$"
                }
              }
            },
            "required": [
              "name",
              "types"
            ],
            "additionalProperties": false
          }
        },
        "captured_at_ms": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        }
      },
      "required": [
        "topics",
        "services",
        "actions",
        "captured_at_ms"
      ],
      "additionalProperties": false
    }
  },
  "required": [
    "type",
    "request_id",
    "graph"
  ],
  "additionalProperties": false
}
