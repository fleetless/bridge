{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "type": {
      "type": "string",
      "const": "job_status"
    },
    "request_id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 64
    },
    "jobs": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "job_id": {
            "type": "string",
            "format": "uuid",
            "pattern": "^([0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[1-8][0-9a-fA-F]{3}-[89abAB][0-9a-fA-F]{3}-[0-9a-fA-F]{12}|00000000-0000-0000-0000-000000000000|ffffffff-ffff-ffff-ffff-ffffffffffff)$"
          },
          "state": {
            "type": "string",
            "enum": [
              "running",
              "succeeded",
              "failed",
              "cancelled",
              "lost"
            ]
          },
          "feedback": {
            "anyOf": [
              {},
              {
                "type": "null"
              }
            ]
          },
          "progress": {
            "anyOf": [
              {
                "type": "number",
                "minimum": 0,
                "maximum": 1
              },
              {
                "type": "null"
              }
            ]
          },
          "result": {
            "anyOf": [
              {},
              {
                "type": "null"
              }
            ]
          },
          "result_omitted": {
            "type": "object",
            "properties": {
              "reason": {
                "type": "string",
                "enum": [
                  "too_large"
                ],
                "description": "Why the result was left out. `too_large`: its frame would have exceeded the robot's frame limit."
              },
              "bytes": {
                "type": "integer",
                "exclusiveMinimum": 0,
                "maximum": 9007199254740991,
                "description": "The size of the result alone, serialised as JSON, in bytes."
              },
              "limit_bytes": {
                "type": "integer",
                "exclusiveMinimum": 0,
                "maximum": 9007199254740991,
                "description": "The frame limit the robot applied, in bytes (`BRIDGE_FRAME_MAX_BYTES`, 1.5 MiB)."
              }
            },
            "required": [
              "reason",
              "bytes",
              "limit_bytes"
            ],
            "additionalProperties": false,
            "description": "The robot had a result and did not send it because it was too large; `result` is `null`. The state is unchanged, and the result cannot be fetched later."
          },
          "error": {
            "anyOf": [
              {
                "type": "object",
                "properties": {
                  "code": {
                    "type": "string",
                    "minLength": 1
                  },
                  "message": {
                    "type": "string",
                    "minLength": 1
                  },
                  "details": {}
                },
                "required": [
                  "code",
                  "message"
                ],
                "additionalProperties": false
              },
              {
                "type": "null"
              }
            ]
          }
        },
        "required": [
          "job_id",
          "state",
          "feedback",
          "progress",
          "result",
          "error"
        ],
        "additionalProperties": false
      }
    },
    "unknown_job_ids": {
      "type": "array",
      "items": {
        "type": "string",
        "format": "uuid",
        "pattern": "^([0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[1-8][0-9a-fA-F]{3}-[89abAB][0-9a-fA-F]{3}-[0-9a-fA-F]{12}|00000000-0000-0000-0000-000000000000|ffffffff-ffff-ffff-ffff-ffffffffffff)$"
      }
    }
  },
  "required": [
    "type",
    "request_id",
    "jobs",
    "unknown_job_ids"
  ],
  "additionalProperties": false
}
