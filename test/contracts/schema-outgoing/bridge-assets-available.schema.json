{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "type": {
      "type": "string",
      "const": "assets_available"
    },
    "urdf": {
      "type": "boolean"
    },
    "meshes": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      }
    }
  },
  "required": [
    "type",
    "urdf",
    "meshes"
  ],
  "additionalProperties": false
}
